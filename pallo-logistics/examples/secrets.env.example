# pallo-logistics secrets — copy to ~/.config/pallo-logistics/secrets.env (perms 600).
# The scripts read this file; the agent must NEVER read it.

# Gingr customer-portal login (Laurel Acres / Tail Wag Inn).
# Used once by gingr-login.py to capture the saved session; never stored elsewhere.
GINGR_LOGIN=<email-or-mobile-phone>
GINGR_PASSWORD=<password>

# Discord coordination channel that BOTH you and Gina are in (shared, not a DM).
# Channel webhook URL + the two numeric user IDs for <@id> mentions.
DISCORD_CHANNEL_WEBHOOK_URL=<https://discord.com/api/webhooks/.../...>
GINA_DISCORD_USER_ID=<discord-user-id>
SELF_DISCORD_USER_ID=<discord-user-id>
