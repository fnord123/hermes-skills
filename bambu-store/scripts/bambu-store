#!/usr/bin/env python3
"""bambu-store - deterministic read/cart CLI for the Bambu Lab US store.

Design: this script does the regular work (catalog index, fuzzy resolve,
price/sale/stock math, cart state, Shopify cart permalink) and returns
compact JSON. The agent (LLM) only parses intent, disambiguates, and
decides go/no-go. Reads are light: a one-time targeted collection SEED,
then per-handle .js refreshes with a TTL. No runtime catalog crawl.
"""
import sys, os, json, time, argparse, urllib.request, urllib.parse, re

DOMAIN = "bambulab-us.myshopify.com"
UA = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/148.0 Safari/537.36"
# Collections that expose products.json and cover what the user buys.
SEED_COLLECTIONS = [
    "bambu-lab-3d-printer-filament", "all-filaments", "cosmetic",
    "anniversary-sale-filament", "filament-refill", "high-performance-filament",
]
HERE = os.path.dirname(os.path.abspath(__file__))
SEED_FILE = os.path.join(HERE, "..", "data", "catalog_seed.json")
CACHE = os.path.expanduser("~/.hermes/cache/bambu-store")
INDEX_FILE = os.path.join(CACHE, "index.json")
CART_DIR = os.path.join(CACHE, "carts")
JS_TTL = 900            # seconds a variant's stock/price stays "fresh"
MAX_ORDER_CENTS = 50000  # Link per-request cap ($500)

def _http_json(url):
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.load(r)

def _ensure_dirs():
    os.makedirs(CACHE, exist_ok=True)
    os.makedirs(CART_DIR, exist_ok=True)

def _load_index():
    if os.path.exists(INDEX_FILE):
        return json.load(open(INDEX_FILE))
    if os.path.exists(SEED_FILE):
        seed = json.load(open(SEED_FILE))
        idx = {"updated": 0, "products": {}}
        for p in seed.get("products", []):
            idx["products"][p["handle"]] = p
        return idx
    return {"updated": 0, "products": {}}

def _save_index(idx):
    _ensure_dirs()
    json.dump(idx, open(INDEX_FILE, "w"))

def _money(cents):
    try:
        return "$%.2f" % (int(cents) / 100.0)
    except Exception:
        return str(cents)

# ---- seed -----------------------------------------------------------------
def cmd_seed(args):
    byhandle = {}
    for col in SEED_COLLECTIONS:
        page = 1
        while page <= 5:
            url = "https://%s/collections/%s/products.json?limit=250&page=%d" % (DOMAIN, col, page)
            try:
                ps = _http_json(url).get("products", [])
            except Exception:
                ps = []
            if not ps:
                break
            for p in ps:
                h = p["handle"]
                rec = byhandle.setdefault(h, {
                    "handle": h, "title": p["title"], "type": p.get("product_type", ""),
                    "tags": p.get("tags", []) if isinstance(p.get("tags"), list) else [],
                    "options": [o["name"] for o in p.get("options", [])],
                    "collections": [], "variants": [
                        {"id": v["id"], "title": v["title"], "price": v["price"],
                         "compare_at": v.get("compare_at_price")} for v in p.get("variants", [])],
                })
                if col not in rec["collections"]:
                    rec["collections"].append(col)
            page += 1
            time.sleep(0.3)
    items = list(byhandle.values())
    os.makedirs(os.path.dirname(os.path.abspath(SEED_FILE)), exist_ok=True)
    json.dump({"domain": DOMAIN, "seeded_from": SEED_COLLECTIONS,
               "count": len(items), "products": items}, open(SEED_FILE, "w"))
    # rebuild runtime index from fresh seed
    idx = {"updated": 0, "products": {p["handle"]: p for p in items}}
    _save_index(idx)
    print(json.dumps({"seeded": len(items), "collections": SEED_COLLECTIONS}))

# ---- per-handle freshness -------------------------------------------------
def _refresh_handle(idx, handle, force=False):
    """Fetch product .js for live price + compare_at + available per variant."""
    rec = idx["products"].get(handle)
    now = int(time.time())
    if rec and not force and (now - rec.get("js_updated", 0) < JS_TTL):
        return rec
    try:
        d = _http_json("https://%s/products/%s.js" % (DOMAIN, handle))
    except Exception as e:
        if rec:
            rec["js_error"] = str(e)
        return rec
    vmap = {v["id"]: v for v in d.get("variants", [])}
    if not rec:
        rec = {"handle": handle, "title": d.get("title", handle),
               "type": d.get("type", ""), "tags": d.get("tags", []),
               "options": d.get("options", []), "collections": [], "variants": []}
        idx["products"][handle] = rec
    rec["title"] = d.get("title", rec.get("title"))
    rec["variants"] = [{
        "id": v["id"], "title": v["title"], "price": v["price"],
        "compare_at": v.get("compare_at_price"), "available": v.get("available"),
    } for v in d.get("variants", [])]
    rec["js_updated"] = now
    rec.pop("js_error", None)
    return rec

def _variant_view(rec, v):
    price = v.get("price")
    ca = v.get("compare_at")
    on_sale = bool(ca) and isinstance(ca, int) and ca > (price or 0)
    out = {
        "handle": rec["handle"], "variant_id": v["id"],
        "label": "%s / %s" % (rec["title"], v["title"]),
        "price": price, "price_display": _money(price),
        "available": v.get("available"),
        "on_sale": on_sale,
    }
    if on_sale:
        out["was"] = _money(ca)
        out["pct_off"] = round(100 * (ca - price) / ca)
    return out

# ---- search / resolve -----------------------------------------------------
_STOP = {"the","a","an","of","for","roll","rolls","spool","spools","filament","please","new","replacement"}
def _tokens(s):
    return [t for t in re.split(r"[^a-z0-9]+", (s or "").lower()) if t and t not in _STOP]

def _score(rec, qtokens):
    hay = " ".join([rec.get("title",""), rec.get("type",""),
                    " ".join(rec.get("tags",[])), " ".join(rec.get("options",[])),
                    " ".join(v["title"] for v in rec.get("variants",[]))]).lower()
    htoks = set(re.split(r"[^a-z0-9]+", hay))
    score = 0
    for t in qtokens:
        if t in htoks: score += 2
        elif t in hay: score += 1
    # strong boost if all query tokens present
    if qtokens and all(t in hay for t in qtokens): score += 3
    return score

def _search(idx, query, limit, refresh=True):
    qt = _tokens(query)
    ranked = sorted(idx["products"].values(), key=lambda r: _score(r, qt), reverse=True)
    ranked = [r for r in ranked if _score(r, qt) > 0][:max(limit, 3)]
    results = []
    for rec in ranked:
        if refresh:
            rec = _refresh_handle(idx, rec["handle"])
        # surface variants matching color/form tokens if any, else first few
        vs = rec.get("variants", [])
        scored = sorted(((sum(1 for t in qt if t in v["title"].lower()), v) for v in vs), key=lambda x: x[0], reverse=True)
        best = scored[0][0] if scored else 0
        picked = [v for sc, v in scored if sc == best and sc > 0] or vs[:3]
        for v in picked[:8]:
            results.append(_variant_view(rec, v))
    return results[: max(limit, 1) * 8]

def cmd_search(args):
    idx = _load_index()
    res = _search(idx, args.query, args.limit)
    _save_index(idx)
    if not res:
        print(json.dumps({"status": "no_match", "query": args.query,
                          "hint": "Not in seeded index; needs browser discovery (parts often are)."}))
        return
    print(json.dumps({"query": args.query, "results": res}, indent=2))

def cmd_price(args):
    idx = _load_index()
    res = _search(idx, args.query, 1)
    _save_index(idx)
    print(json.dumps(res[0] if res else {"status": "no_match", "query": args.query}, indent=2))

def cmd_resolve(args):
    idx = _load_index()
    q = " ".join(x for x in [args.material, args.color, args.form] if x)
    res = _search(idx, q, args.limit if hasattr(args, "limit") else 5)
    _save_index(idx)
    if len(res) == 1:
        print(json.dumps({"resolved": res[0]}, indent=2))
    elif res:
        print(json.dumps({"ambiguous": res}, indent=2))
    else:
        print(json.dumps({"status": "no_match", "query": q}))

# ---- cart -----------------------------------------------------------------
def _cart_path(thread):
    safe = re.sub(r"[^A-Za-z0-9_-]", "_", str(thread))
    return os.path.join(CART_DIR, safe + ".json")

def _load_cart(thread):
    p = _cart_path(thread)
    return json.load(open(p)) if os.path.exists(p) else {"thread": thread, "items": []}

def _save_cart(thread, cart):
    _ensure_dirs()
    json.dump(cart, open(_cart_path(thread), "w"))

def _cart_view(idx, cart):
    lines, subtotal, any_unknown = [], 0, False
    for it in cart["items"]:
        rec = _refresh_handle(idx, it["handle"])
        v = next((x for x in (rec.get("variants", []) if rec else []) if x["id"] == it["variant_id"]), None)
        if not v:
            any_unknown = True
            lines.append({"variant_id": it["variant_id"], "qty": it["qty"], "status": "unknown"})
            continue
        lv = _variant_view(rec, v)
        line = it["qty"] * (v.get("price") or 0)
        subtotal += line
        lines.append({**lv, "qty": it["qty"], "line_total": _money(line)})
    return {"thread": cart["thread"], "items": lines,
            "subtotal_cents": subtotal, "subtotal": _money(subtotal),
            "over_cap": subtotal > MAX_ORDER_CENTS,
            "cap": _money(MAX_ORDER_CENTS), "incomplete": any_unknown}

def cmd_cart(args):
    idx = _load_index()
    cart = _load_cart(args.thread)
    if args.action == "add":
        for it in cart["items"]:
            if it["variant_id"] == args.variant:
                it["qty"] += args.qty
                break
        else:
            cart["items"].append({"handle": args.handle, "variant_id": args.variant, "qty": args.qty})
        _save_cart(args.thread, cart)
    elif args.action == "remove":
        cart["items"] = [it for it in cart["items"] if it["variant_id"] != args.variant]
        _save_cart(args.thread, cart)
    elif args.action == "clear":
        cart["items"] = []
        _save_cart(args.thread, cart)
    view = _cart_view(idx, cart)
    _save_index(idx)
    print(json.dumps(view, indent=2))

def cmd_cart_url(args):
    cart = _load_cart(args.thread)
    if not cart["items"]:
        print(json.dumps({"status": "empty"})); return
    parts = ["%s:%d" % (it["variant_id"], it["qty"]) for it in cart["items"]]
    print(json.dumps({"cart_url": "https://%s/cart/%s" % (DOMAIN, ",".join(parts))}))

def cmd_refresh(args):
    idx = _load_index()
    handles = args.handle or []
    if args.cart:
        handles += [it["handle"] for it in _load_cart(args.cart)["items"]]
    handles = sorted(set(h for h in handles if h))
    for h in handles:
        _refresh_handle(idx, h, force=True)
    _save_index(idx)
    print(json.dumps({"refreshed": handles}))

def main():
    ap = argparse.ArgumentParser(prog="bambu-store")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("seed")
    s = sub.add_parser("search"); s.add_argument("query"); s.add_argument("--limit", type=int, default=5)
    s = sub.add_parser("price"); s.add_argument("query")
    s = sub.add_parser("resolve")
    s.add_argument("--material"); s.add_argument("--color"); s.add_argument("--form"); s.add_argument("--limit", type=int, default=5)
    s = sub.add_parser("cart")
    s.add_argument("action", choices=["show", "add", "remove", "clear"])
    s.add_argument("--thread", required=True); s.add_argument("--handle")
    s.add_argument("--variant", type=int); s.add_argument("--qty", type=int, default=1)
    s = sub.add_parser("cart-url"); s.add_argument("--thread", required=True)
    s = sub.add_parser("refresh"); s.add_argument("--handle", action="append"); s.add_argument("--cart")
    args = ap.parse_args()
    {"seed": cmd_seed, "search": cmd_search, "price": cmd_price, "resolve": cmd_resolve,
     "cart": cmd_cart, "cart-url": cmd_cart_url, "refresh": cmd_refresh}[args.cmd](args)

if __name__ == "__main__":
    main()