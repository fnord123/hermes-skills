# Daily-briefing pipeline secrets. Copy to `.env` and fill in.
#
# Loaded by morning-briefing.sh via `set -a; source .env; set +a` so all
# fetch-*.sh helpers see these values via the environment. Deliberately
# kept out of the Hermes config tree — the companion skill instructs the
# agent to never read this file or any *.log file under the briefing dir.

# ── Calendar ────────────────────────────────────────────────────────────────
# Google Calendar secret iCal URL.
# calendar.google.com → settings → "secret address in iCal format".
# Treat as a credential — anyone with this URL can read the calendar.
GCAL_ICAL_KEY=

# ── News ────────────────────────────────────────────────────────────────────
# Brave Search News API key.  Sign up: https://brave.com/search/api/
# Free tier: 2,000 queries/month. fetch-news.sh runs roughly one call per
# topic in news-topics.json per briefing.
BRAVE_API_KEY=

# ── Markets ─────────────────────────────────────────────────────────────────
# Twelve Data API key for the __Markets__ block (used for bare US tickers).
# Sign up: https://twelvedata.com/pricing  (Basic / free; no card required).
# Free tier: 800 calls/day, 8/min. Free tier covers US listings only;
# international (Euronext, LSE, Tokyo, etc.) require Grow plan or higher.
# Tickers with a Yahoo-style suffix (e.g. SU.PA, 7203.T) route through
# yfinance instead and don't need this key.
TWELVE_DATA_API_KEY=

# ── Weather ─────────────────────────────────────────────────────────────────
# US National Weather Service gridpoint, format OFFICE/X,Y.
# Example: OKX/33,42 (New York City).  Find your local gridpoint:
#   curl -s 'https://api.weather.gov/points/<lat>,<lon>' | jq -r .properties.forecastGridData
# The response URL ends with /gridpoints/OFFICE/X,Y — that's the value.
# (Non-US: swap fetch-weather.sh for an open-meteo / openweathermap variant.)
NWS_GRIDPOINT=

# Optional: User-Agent for NWS API. They request a contact email or URL.
# NWS_USER_AGENT="my-briefing my.email@example.com"

# ── Timezone ────────────────────────────────────────────────────────────────
# IANA timezone for briefing date formatting (the "Wednesday, May 6, 2026"
# line at the top + the archive filename). Defaults to America/New_York;
# set this if you want briefings anchored to a different zone.
# BRIEFING_TZ=America/New_York

# ── Output ──────────────────────────────────────────────────────────────────
# Discord webhook URL for the briefing channel.
# Channel → Settings → Integrations → Webhooks → New Webhook ("Daily Briefing").
# Anyone with this URL can post to the channel as the webhook user.
BRIEFING_WEBHOOK_URL=

# Optional: Discord bot token, used to attach a date-named thread to each
# posted briefing. Without this, the briefing posts as a regular channel
# message and no thread is created. The bot must be in the server and have
# "Create Public Threads" permission on the briefing channel. Easiest path
# is to reuse your existing Hermes bot's token (Server Settings →
# Integrations → [your bot] → grant "Create Public Threads" if not already
# on). Or create a separate bot for this — daily-briefing only needs the
# token for the API call, not a running gateway.
BRIEFING_BOT_TOKEN=
