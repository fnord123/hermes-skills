# webaccess runtime secrets — NEVER commit. Copy to .env on the docker host.
#
# BROWSE_API_KEY: the LiteLLM proxy key for the agent rung (rx-* shared key).
# BROWSE_BASE_URL / BROWSE_MODEL may live here instead of service.yaml when
# they differ per host; process env from compose always wins over service.yaml.
BROWSE_API_KEY=
BROWSE_BASE_URL=
BROWSE_MODEL=

# Optional metered rung (BrowserBase). Off by default; enabling requires
# both creds and flipping WEB_ALLOW_BROWSERBASE=1 (service.yaml / compose env).
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
