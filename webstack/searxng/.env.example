# searxng engine secrets — copy to .env, fill in, chmod 0600. NEVER commit the real .env.
# Read by apply-api-engines.sh (host-side) only; not passed into the container.
#
# SEARXNG_BRAVE_API_KEY: Brave Search key for the "brave api" engine
# (api-engines.yml references it as ${SEARXNG_BRAVE_API_KEY}).
# Empty/missing => the engine is skipped at apply time.
SEARXNG_BRAVE_API_KEY=
