# webstack top-level env — firecrawl vendor-stack variables + searxng session secret.
# NEVER commit. Copy to .env on the docker host. Values shown as [REDACTED] must be
# taken from the existing /home/dputzolu/webstack/.env on .226 (it stays in place
# during cutover; this file is for fresh-host replication).
#
# SEARXNG_SECRET: SearXNG session-signing secret. The member compose passes it as an
# env var into the container, and the searxng image's settings loader lets it override
# server.secret_key in settings.yml — which is why the tracked config carries no
# secret_key at all. Generate:  head -c 32 /dev/urandom | base64 | tr -dc 'a-zA-Z0-9'
SEARXNG_SECRET=
NUM_WORKERS_PER_QUEUE=[REDACTED]
MAX_CONCURRENT_JOBS=[REDACTED]
CRAWL_CONCURRENT_REQUESTS=[REDACTED]
BROWSER_POOL_SIZE=[REDACTED]
PORT=[REDACTED]
HOST=[REDACTED]
USE_DB_AUTHENTICATION=[REDACTED]
REDIS_URL=redis://redis:6379
REDIS_RATE_LIMIT_URL=redis://redis:6379
PLAYWRIGHT_MICROSERVICE_URL=http://playwright-service:3000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_HOST=[REDACTED]
POSTGRES_PORT=[REDACTED]
SEARXNG_ENDPOINT=[REDACTED]
BULL_AUTH_KEY=[REDACTED]
LOGGING_LEVEL=info
