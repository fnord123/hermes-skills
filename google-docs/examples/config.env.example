# google-docs skill configuration.
# Copy to ~/.config/google-docs/config.env and fill in the folder ID.
#
# The Drive folder (owned by the service-account's Workspace steward) that new
# documents are created inside. The service account must be shared as Editor on
# this folder. See README.md for the one-time GCP/Drive setup.
GOOGLE_DOCS_FOLDER_ID=
