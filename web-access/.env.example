# webaccess service secrets — copy to .env, fill in, do NOT commit.
# This file is loaded into the container's process env (compose env_file)
# and takes precedence over config.env inside the image.

# LiteLLM route the Fara agent talks to (model name `fara`).
BROWSE_BASE_URL=http://docker.putzolu.com:4000/v1
BROWSE_MODEL=fara
BROWSE_API_KEY=

# BrowserBase — only needed if WEB_ALLOW_BROWSERBASE=1 is ever set.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Tier-5 bladebro runner transport. The code DEFAULT ("ssh ... docker") is host-era: it assumes
# the fetcher runs on a machine that can ssh to the docker host. webaccess runs INSIDE that
# docker host's container — no ssh binary in the image — so the default dies with
# FileNotFoundError and the gate-breaking tier silently never fires (measured 2026-10-18:
# every Anubis-gated page fell to 'bladebro unreachable' while /health cheerfully reported
# bladebro 'configured', which only checks this var's truthiness). The container carries the
# docker CLI and the sock is mounted, so launch the one-shot locally:
BLADEBRO_SSH=sh -c

# Reddit mirror rung (text lane): ordered redlib instances tried for every reddit URL;
# the winner is pinned ~6h, dead/hung instances fail over (one REDLIB_TIMEOUT each).
# Code default: safereddit.com — set this only to replace or extend the candidate list.
# Reality check (2026-10-16): the PUBLIC redlib fleet JS-challenge-gates anonymous visitors
# (Anubis: "Making sure you're not a bot!"). Plain HTTP can't solve that, so the ladder aims
# a GATED mirror url at the render rungs — a browser passes the gate by design. If every
# instance goes dark, the durable fix is a self-hosted redlib on .226 or Reddit's unblock
# ticket — not editing this list.
# REDLIB_HOSTS=safereddit.com,redlib.example2
# REDLIB_TIMEOUT=20
