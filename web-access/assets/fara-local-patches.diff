diff --git a/src/fara/run_fara.py b/src/fara/run_fara.py
index 18509ee..64a6204 100755
--- a/src/fara/run_fara.py
+++ b/src/fara/run_fara.py
@@ -140,6 +140,32 @@ async def run_fara15_agent(
             task_text = None
             first_round = False
     finally:
+        # LOCAL PATCH (see hermes-skills/web-access/README.md): emit the LANDED PAGE'S verbatim
+        # text before tearing the browser down. The environment already has this — the agent's
+        # own read_page_answer_question calls get_page_markdown() and then throws the markdown
+        # away in favour of the model's answer. web-access needs the opposite: an agent that
+        # navigates (consent walls, interstitials, multi-step flows) and then hands back the
+        # real document, because its citation audit locates verbatim quotes at real offsets and
+        # a paraphrase breaks that silently. Same session, so the cookies and JS state the agent
+        # just established are still in force.
+        dump_to = os.environ.get("FARA_DUMP_MARKDOWN")
+        if dump_to:
+            try:
+                md = await env.get_page_markdown()
+                Path(dump_to).write_text(md or "", encoding="utf-8")
+                # The LANDED url, beside the markdown. Without it the caller cannot tell the
+                # requested document from whatever the agent wandered to: on 2026-08-03 fara
+                # met Home Depot's error page, refreshed onto the HOMEPAGE, dismissed a popover
+                # and reported success — and 18,307 characters of site navigation were accepted
+                # as the product page.
+                try:
+                    landed = env._page.url
+                except Exception:  # noqa: BLE001
+                    landed = ""
+                Path(str(dump_to) + ".url").write_text(landed, encoding="utf-8")
+                print(f"Page markdown written to: {dump_to} ({len(md or '')} chars) from {landed}")
+            except Exception as e:  # noqa: BLE001
+                print(f"Page markdown dump failed: {type(e).__name__}: {e}")
         await env.close()
 
 
