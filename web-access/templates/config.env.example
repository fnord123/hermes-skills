# browse-task configuration — copy to config.env and fill in.
# config.env is git-ignored; keep the API key out of the repo.

# Where Microsoft's Fara scaffold is installed (git clone + venv). The script
# calls $FARA_HOME/.venv/bin/fara-cli. See README for the one-time setup.
FARA_HOME=/home/youruser/fara

# The OpenAI-compatible endpoint that serves the browser-agent model.
# (An LiteLLM proxy route works well.)
BROWSE_BASE_URL=http://192.168.1.226:4000/v1
BROWSE_MODEL=fara
BROWSE_API_KEY=REPLACE_WITH_ENDPOINT_KEY

# ── optional ────────────────────────────────────────────────────────────────
# Diagnostic log. Default: a per-day file in the OS temp dir, auto-aged by the OS.
# Set a persistent path to keep logs indefinitely.
# BROWSE_LOG=/home/youruser/.hermes/logs/browse-task.log

# Pre-seed cookies (delivery location, login) before the agent starts. JSON list
# of Playwright cookies; domain-scoped so it's inert on other sites. See README.
# BROWSE_COOKIES=/home/youruser/.config/browse-task/costco-97219.json

# Browser mode. Default 'auto' picks per-site (headless / headful+xvfb /
# browserbase); the built-in policy covers costco/amazon/reddit/newegg. Override
# the table with a JSON file, or force one mode globally.
# BROWSE_SITE_POLICY=/home/youruser/.config/browse-task/site-policy.json
# BROWSE_MODE=auto

# For sites not in the policy, the wrapper probes headless->headful->browserbase
# to auto-detect what loads, and remembers the winner per-domain here. Set
# BROWSE_AUTOPROBE=false to disable and just use the default mode.
# BROWSE_AUTOPROBE=true
# BROWSE_LEARNED_POLICY=/home/youruser/.config/browse-task/learned.json

# BrowserBase (managed browser) — only needed for bot-hardened sites (e.g.
# Costco) that block both headless and headful. Sign up at browserbase.com.
# Needs BOTH the key and the project id (here, the process env, or ~/.hermes/.env).
# BROWSERBASE_API_KEY=bb_...
# BROWSERBASE_PROJECT_ID=...
