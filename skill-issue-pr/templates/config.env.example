# skill-issue-pr configuration.
# Copy to ~/.config/skill-issue-pr/config.env and fill in.
#
# The script owns this file; it never writes it on its own.
REPO=
# owner/name - the repo the skills go to. Leave blank to use the
# current directory's repo. --repo owner/name overrides it per call.
BOT_LOGIN=
# the bot account's login name (required only when --as-bot is used).
