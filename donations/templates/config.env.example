# donations config — copy to ~/.config/donations/config.env (chmod 600).
# The script reads this; it is not a secret but keep it out of the repo.

# The spreadsheet id (from the sheet's URL: /spreadsheets/d/<THIS>/edit).
# The service account must be shared as Editor on this spreadsheet.
DONATIONS_SHEET_ID=<spreadsheet-id>

# Auth is separate: the service-account key path comes from
# GOOGLE_APPLICATION_CREDENTIALS in ~/.hermes/.env, not from this file.
