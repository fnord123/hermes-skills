# Archivist digest pipeline secrets.
#
# Loaded by post-digest.sh via `set -a; source .env; set +a`. Deliberately
# separate from ~/.hermes/profiles/Archivist/.env so the agent does NOT see
# the webhook URL — only the cron pipeline needs it.

# Discord webhook URL for the #archivist channel.
# install.sh creates one for you and writes it here, OR create manually:
# Channel → Settings → Integrations → Webhooks → New Webhook ("Archivist Digest").
ARCHIVIST_WEBHOOK_URL=

# Path to the Archivist vault — same value as in the profile's .env.
# Typically ~/.hermes/profiles/Archivist/vault
ARCHIVIST_VAULT_PATH=
