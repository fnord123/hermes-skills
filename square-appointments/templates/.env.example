# square-appointments secrets. Copy to `.env` and fill in.
#
# Loaded by each script via stdlib parsing. The SKILL.md explicitly forbids
# the agent from reading this file; secrets are sourced by scripts at runtime.

# ── AgentMail ────────────────────────────────────────────────────────────────
# Same value as in ~/.hermes/config.yaml under mcp_servers.agentmail.env.
# Console: https://console.agentmail.to
AGENTMAIL_API_KEY=

# Optional: explicit inbox to use. Leave blank to auto-discover via
# /v0/inboxes (works if your API key is scoped to exactly one inbox, which
# is the common case).
AGENTMAIL_INBOX_ID=

# ── Merchant config location ─────────────────────────────────────────────────
# Path to merchants.json. Defaults to ~/.config/square-appointments/merchants.json.
# MERCHANTS_FILE=
