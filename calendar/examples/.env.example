# calendar skill secrets. Copy to `.env` and fill in.
#
# Loaded by each script via a tiny stdlib parser. The SKILL.md explicitly
# forbids the agent from reading this file.

# ── Calendar source ─────────────────────────────────────────────────────────
# Google Calendar's "secret address in iCal format" URL.
#   calendar.google.com → Settings → <your calendar> → "Secret address in
#   iCal format". Treat as a credential — anyone with this URL can read
#   the calendar.
#
# This is the SAME value as ~/daily-briefing/.env's GCAL_ICAL_KEY if you
# have the daily-briefing pipeline already set up; just copy it across.
GCAL_ICAL_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# Timezone for date interpretation. IANA tz name (e.g. America/New_York,
# America/Los_Angeles, Europe/London). Defaults to BRIEFING_TZ if not set,
# then to America/New_York. Set this if you want the schedule scripts to
# anchor to a different zone than daily-briefing.
# SCHEDULE_TZ=America/Los_Angeles

# Optional path to a daily-briefing-style calendar-people.json file mapping
# organizer emails to display names. If set, events will be enriched with
# an `organizer` field carrying the resolved name. Same schema as
# ~/daily-briefing/calendar-people.json:
#   { "default": "Me", "organizers": { "alice@x.com": "Alice", ... } }
# CALENDAR_PEOPLE_JSON=
